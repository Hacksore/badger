# Copy to .env and adjust (optional — scripts use sane defaults).

# Mounted badge volume (macOS)
# BADGER_MOUNT=/Volumes/BADGER

# Path to your clone of https://github.com/pimoroni/badgeware-simulator
# Default: sibling directory ../badgeware-simulator
# BADGEWARE_SIM=/Users/you/code/badgeware-simulator

# What to sync from this repo (relative to repo root). Default: entire tree minus .badgeignore
# BADGE_SRC=.

# Simulated filesystem root inside badgeware-simulator (used by ./go root)
# SIM_ROOT=root-badgeware

# Set to 1 to pass --delete to rsync (removes dest files not in source). Dangerous on hardware.
# SYNC_DELETE=0
